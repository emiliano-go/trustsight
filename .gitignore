__pycache__/
*.pyc
.totem/
.claude/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
*.diff
# Malicious fixture .diff bodies are committed source (fixture reproducibility);
# only the generic pattern above is overridden for these directories.
!tests/fixtures/malicious/**/*.diff
# X028's two-commit split across consecutive commits is committed source.
!tests/fixtures/x028-split-fetch/**/*.diff
# The curated benign manifest corpus is committed source: the locked AUR
# corpus carries no dependency manifests, so the U-series scored rules are
# measured against it by the calibration gates.
!tests/fixtures/manifest-corpus/**/*.diff
site/

# Uncompressed seed; only the .gz is shipped
src/trustsight/data/seed.db

# Generated by zensical (debug_dir in zensical.toml)
.zensical-debug/
.seo-debug/

# makepkg build artifacts
packaging/aur/pkg/
packaging/aur/src/
packaging/aur/*.tar.gz
packaging/aur/*.pkg.tar.*
packaging/local/pkg/
packaging/local/src/
packaging/local/*.pkg.tar.*

# Local probe-corpus replay output (scratch, not shipped)
/probe*.json

# Full AUR metadata dump (scratch, not shipped)
/full-aur-meta.json

# Release workflow scratch directory
release/
