# Optional AppArmor profile for the watcher container.
#
# Load it on the host, then set TRUSTSIGHT_APPARMOR_PROFILE=trustsight-watcher
# when starting compose.  The profile must allow mount/userns because the
# parser workers create their own namespaces; the watcher remains the only
# service that cannot use docker-default for that reason.
#
#   sudo apparmor_parser -r docker/apparmor/trustsight-watcher

#include <tunables/global>

profile trustsight-watcher flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network netlink raw,

  signal,

  # Parser workers: private namespaces plus a proc/tmpfs mount.
  mount,
  umount,
  pivot_root,
  userns,
  userns create,
  capability sys_admin,

  /app/ r,
  /app/** rix,
  /usr/** rix,
  /lib/** rix,
  /lib64/** rix,
  /etc/ssl/** r,
  /etc/resolv.conf r,
  /etc/host.conf r,
  /etc/hosts r,
  /etc/gai.conf r,
  /etc/nsswitch.conf r,
  /etc/passwd r,
  /etc/group r,
  /tmp/** rwk,
  /run/trustsight/** rw,
  /config-src/** r,
  /config/** rw,
  /data/** rwk,
  /proc/** r,
  /proc/self/uid_map rw,
  /proc/self/gid_map rw,
  /proc/self/setgroups rw,
  /proc/*/uid_map w,
  /proc/*/gid_map w,
  /proc/*/setgroups w,
  /sys/devices/system/cpu/** r,
  /sys/fs/cgroup/** r,
  /sys/fs/cgroup/cpu.max r,
  /dev/urandom r,
  /dev/null rw,
}
