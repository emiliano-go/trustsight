{
  "$schema": "https://static.modelcontextprotocol.io/schemas/v1/server-card.schema.json",
  "name": "org.trustsight/watcher",
  "version": "1.0.0",
  "title": "TrustSight Watcher",
  "description": "Read-only alerts and rule triggers from the TrustSight AUR watcher.",
  "websiteUrl": "https://trustsight.org/",
  "repository": {
    "source": "github",
    "url": "https://github.com/emiliano-go/trustsight-feed"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://trustsight.org/mcp",
      "supportedProtocolVersions": ["2025-06-18", "2025-03-26"]
    }
  ],
  "serverInfo": {
    "name": "trustsight-watcher",
    "version": "1.0.0"
  },
  "transport": {
    "type": "streamable-http",
    "endpoint": "https://trustsight.org/mcp"
  },
  "capabilities": {
    "tools": {
      "listChanged": false
    }
  },
  "tools": [
    {
      "name": "search-alerts",
      "description": "Search the public TrustSight watcher feed for alerts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": { "type": "string", "minLength": 1 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 }
        },
        "required": ["q"],
        "additionalProperties": false
      }
    },
    {
      "name": "latest-alerts",
      "description": "Return the most recent TrustSight watcher alerts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "package-history",
      "description": "Return every stored alert that names an AUR package, with its rule firings and version transitions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "package": { "type": "string", "minLength": 1 }
        },
        "required": ["package"],
        "additionalProperties": false
      }
    },
    {
      "name": "rule-triggers",
      "description": "Return normalized triggers for one TrustSight rule id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "rule": { "type": "string", "pattern": "^[A-Z][0-9]{3}$" },
          "since": { "type": "integer", "minimum": 0 }
        },
        "required": ["rule"],
        "additionalProperties": false
      }
    }
  ]
}
