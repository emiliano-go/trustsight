# TrustSight Baseline Registry Public Key
#
# This file will contain the ed25519 public key (raw 32 bytes) once a
# key pair is generated for distribution.  For now it is a placeholder.
#
# Key generation (offline, done once):
#   openssl genpkey -algorithm ed25519 -out k_snapshot.pem
#   openssl pkey -in k_snapshot.pem -pubout -out k_snapshot_pub.pem
#   python3 -c "import sys; key = open('k_snapshot_pub.pem','rb').read()
#   from cryptography.hazmat.primitives.serialization import load_pem_public_key
#   k = load_pem_public_key(key); open('baseline_pubkey.pem','wb').write(
#       k.public_bytes_raw())"
#
# After that, place baseline_pubkey.pem in src/trustsight/full_aur/
# alongside this placeholder, then remove this comment.
